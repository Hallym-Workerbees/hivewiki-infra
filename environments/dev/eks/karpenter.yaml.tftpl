apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: ${nodepool_name}
spec:
  template:
    spec:
      requirements:
        - key: kubernetes.io/arch
          operator: In
          values: ["arm64"]
        - key: kubernetes.io/os
          operator: In
          values: ["linux"]
        - key: karpenter.sh/capacity-type
          operator: In
          values: ["${capacity_type}"]
        - key: karpenter.k8s.aws/instance-category
          operator: In
          values: ${instance_categories_json}
        - key: karpenter.k8s.aws/instance-generation
          operator: Gt
          values: ["${instance_generation_gt}"]
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: ${nodeclass_name}
      expireAfter: ${expire_after}
  limits:
    cpu: "${cpu_limit}"
  disruption:
    consolidationPolicy: ${consolidation_policy}
    consolidateAfter: ${consolidate_after}
---
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: ${nodeclass_name}
spec:
  role: "${node_role_name}"
  amiSelectorTerms:
    - alias: "${ami_alias}"
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: "${cluster_name}"
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: "${cluster_name}"
  tags:
    ManagedBy: "Karpenter"
